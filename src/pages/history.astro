---
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Activity History</title>
    <link rel="stylesheet" href={`${base}assets/styles.css`}>
  </head>
  <body>
    <main class="app-shell">
      <section class="history-page panel">
        <div class="brand-row">
          <div>
            <p class="eyebrow">Daily validation</p>
            <h1>Activity history</h1>
          </div>
          <div class="brand-actions">
            <a class="admin-link" href={base}>Generator</a>
            <a class="admin-link" href={`${base}admin/`}>Admin</a>
          </div>
        </div>

        <div class="history-toolbar">
          <strong id="historySummary">Loading history...</strong>
          <div class="pager-controls">
            <button id="prevPage" type="button">Prev</button>
            <span id="pageStatus">Page 1</span>
            <button id="nextPage" type="button">Next</button>
          </div>
        </div>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Day</th>
                <th>Date</th>
                <th>Run/walk</th>
                <th>Push-ups</th>
                <th>Activity</th>
              </tr>
            </thead>
            <tbody id="historyBody"></tbody>
          </table>
        </div>
      </section>
    </main>

    <script is:inline src={`${base}assets/history.js`}></script>
  </body>
</html>
